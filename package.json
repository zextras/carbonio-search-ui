{
	"name": "@zextras/carbonio-search-ui",
	"version": "0.0.7",
	"description": "Search module for Zextras Carbonio",
	"files": [
		"lib",
		"THIRDPARTIES"
	],
	"exports": {
		".": {
			"types": "./lib/lib.d.ts"
		},
		"./*": null
	},
	"scripts": {
		"build": "sdk build",
		"build:dev": "sdk build --dev --pkgRel $(date +%s)",
		"build:lib": "rm -rf lib && tsc -P tsconfig.lib.json",
		"deploy": "sdk install",
		"start": "sdk watch",
		"prepare": "(is-ci || husky); pnpm run build:lib",
		"type-check": "tsc --noEmit",
		"type-check:watch": "pnpm run type-check -- --watch",
		"lint": "eslint --ext .js,.jsx,.ts,.tsx --resolve-plugins-relative-to node_modules/@zextras/carbonio-ui-configs src",
		"test": "vitest run"
	},
	"keywords": [],
	"author": "Zextras Team <https://www.zextras.com/carbonio/>",
	"license": "AGPL-3.0-only",
	"packageManager": "pnpm@10.32.1",
	"engines": {
		"node": "v22",
		"pnpm": ">=10"
	},
	"devDependencies": {
		"@babel/core": "7.29.0",
		"@babel/preset-env": "7.29.2",
		"@babel/preset-react": "7.28.5",
		"@babel/preset-typescript": "7.28.5",
		"@commitlint/cli": "20.5.0",
		"@commitlint/config-conventional": "20.5.0",
		"@emotion/babel-plugin": "11.13.5",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.1",
		"@types/node": "25.6.0",
		"@types/react": "18.3.28",
		"@types/react-dom": "18.3.7",
		"@vitejs/plugin-react": "5.2.0",
		"@vitest/coverage-v8": "4.1.5",
		"@zextras/carbonio-ui-configs": "2.1.0",
		"@zextras/carbonio-ui-sdk": "2.2.2",
		"dotenv": "16.6.1",
		"eslint": "8.57.1",
		"eslint-plugin-notice": "1.0.0",
		"husky": "9.1.7",
		"is-ci": "4.1.0",
		"jsdom": "29.0.2",
		"prettier": "3.8.3",
		"sonarqube-scanner": "4.3.6",
		"typescript": "5.9.3",
		"vitest": "4.1.5"
	},
	"dependencies": {
		"@emotion/react": "11.14.0",
		"@emotion/styled": "11.14.1",
		"@zextras/carbonio-design-system": "12.0.0",
		"@zextras/carbonio-shell-ui": "14.0.1",
		"core-js": "3.49.0",
		"i18next": "22.5.1",
		"immer": "10.2.0",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-i18next": "12.3.1",
		"react-router-dom": "6.30.3",
		"zustand": "5.0.12"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"core-js",
			"protobufjs",
			"unrs-resolver"
		]
	},
	"browserslist": [
		">1%",
		"last 3 version",
		"Firefox ESR",
		"not dead"
	],
	"carbonio": {
		"translations_repository": "",
		"name": "carbonio-search-ui",
		"priority": 1000,
		"type": "carbonio",
		"display": "Search",
		"icon": "SearchModOutline"
	}
}
