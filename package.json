		"babel-jest": "^29.7.0",
		"dotenv": "^16.5.0",
		"eslint-plugin-notice": "^1.0.0",
		"husky": "^9.1.7",
		"is-ci": "^4.1.0",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"jest-fail-on-console": "^3.3.1",
